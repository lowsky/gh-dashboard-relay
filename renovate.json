{
  "persistRepoData": true,
  "ignoreDeps": [],
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    }
  ],

  "autoApprove": true,
  "automergeStrategy": "squash",
  "extends": [
      ":dependencyDashboard",
      ":separateMultipleMajorReleases",
      ":pinDevDependencies",
      "config:best-practices",
      "config:recommended",
  ]
}
